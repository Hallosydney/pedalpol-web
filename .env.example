# ==============================================================================
# PEDALPOL WEB — ENVIRONMENT VARIABLES
# Salin file ini menjadi .env.local untuk pengembangan lokal,
# atau isi langsung di Project Settings -> Environment Variables pada Vercel.
# ==============================================================================

# 1. Password Panel Admin (/admin) & Secret Cookie Session
ADMIN_PASSWORD=pedalpol2026
ADMIN_SESSION_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter
IP_HASH_SALT=ganti-dengan-salt-rahasia-pedalpol

# 2. Kontak WhatsApp Admin (format internasional tanpa +, contoh: 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3. Supabase (OPSIONAL untuk dev lokal — jika kosong, otomatis pakai local JSON DB)
# Wajib diisi saat deploy produksi ke Vercel agar data persisten di PostgreSQL & Storage!
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
